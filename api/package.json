{
  "name": "@carmitra/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "build": "esbuild src/server.ts src/netlify.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@carmitra/shared=../shared/src/index.ts --outdir=dist",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@carmitra/shared": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
