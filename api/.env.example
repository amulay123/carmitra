# For the admin script (sticker batches), or a host other than Netlify.
# Netlify's settings are in .env.netlify.example. Never commit the real file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_PROJECT_ID=wesafe-40d85
PUBLIC_URL=https://carmitra.wesafeqr.com
WEB_ORIGINS=https://carmitra.wesafeqr.com
PORT=8788

# Number of proxies in front of this server (1 behind one load balancer or nginx).
# It decides how a visitor's IP address is read for the scan and chat limits.
TRUST_PROXY=1

# The WhatsApp gateway token. Leave empty to record chats without sending alerts.
WHATSAPP_TOKEN=
