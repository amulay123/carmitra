# Copy to .env.netlify, fill in, then import it under Environment variables in Netlify.
# .env.netlify stays on your computer. Never commit it.

# WeSafe's Firebase web settings, the same values PetSafeQR uses. They are public: they ship
# inside the website.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wesafe-40d85.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wesafe-40d85
VITE_FIREBASE_STORAGE_BUCKET=wesafe-40d85.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The same value as VITE_FIREBASE_API_KEY. It tells Netlify's secret scanner that this key is
# meant to be public, so the scanner doesn't stop the deploy.
SECRETS_SCAN_SMART_DETECTION_OMIT_VALUES=

# The WhatsApp gateway token WeSafe uses. Without it, chats work but owners get no WhatsApp alert.
WHATSAPP_TOKEN=

# Optional. Both default to the site's main Netlify domain, which is usually what you want.
# VITE_PUBLIC_URL=https://carmitra.wesafeqr.com
# PUBLIC_URL=https://carmitra.wesafeqr.com

# Optional. The links to the sister products and to TommyAndFurry.
# VITE_WESAFE_URL=https://wesafeqr.com
# VITE_PETSAFE_URL=https://petsafe.wesafeqr.com
# VITE_TOMMYANDFURRY_URL=https://tommyandfurry.com

# FIREBASE_SERVICE_ACCOUNT does not go here. Add it in Netlify on its own: see README.md.
